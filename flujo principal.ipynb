   "source": [
    "## Descargar el conjunto de datos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "135a9e4a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Descargar el conjunto de datos completo\n",
    "dataset_ruta_kaggle = kagglehub.dataset_download(\n",
    "    \"meowmeowmeowmeowmeow/gtsrb-german-traffic-sign\"\n",
    ")\n",
    "\n",
    "print(\"\\nArchivos y directorios en el conjunto de datos:\")\n",
    "for ruta_raiz, dircs, archivos in os.walk(dataset_ruta_kaggle):\n",
    "    for nombre in dircs:\n",
    "        print(os.path.join(ruta_raiz, nombre) + '/')\n",
    "    for nombre in archivos:\n",
    "        print(os.path.join(ruta_raiz, nombre))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a828037b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Listamos los directorios que se descargaron\n",
    "print(os.listdir('/kaggle/input/gtsrb-german-traffic-sign/'))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "891442c0",
   "metadata": {},
   "source": [
    "## Convertir en arreglos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "94d6cc7c",
   "metadata": {},
   "outputs": [],
   "source": [
    "datos = []\n",
    "etiquetas = []\n",
    "clases = 43\n",
    "\n",
    "# Cargar datos\n",
    "datos = []\n",
    "etiquetas = []\n",
    "clases = 43\n",
    
    "IMAGES_PER_CLASS = 300\n",
    
    "for i in range(clases):\n",
        "ruta = os.path.join(dataset_ruta_kaggle, 'train', str(i))\n",
        "images = os.listdir(ruta)[:IMAGES_PER_CLASS]\n",
    
        "for a in images:\n",
            "try:\n",
                "img = Image.open(os.path.join(ruta, a)).convert('RGB')\n",
                "img = img.resize((30, 30))\n",
                "img = np.array(img, dtype=np.uint8)\n",
                "datos.append(img)\n",
                "etiquetas.append(i)\n",
            "except:\n",
                "pass\n",
    
    "datos = np.array(datos)\n",
    "etiquetas = np.array(etiquetas)\n",
    
    "print("Dataset cargado:", datos.shape)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "af3ac453",
   "metadata": {},
   "source": [
    "## Separar el conjunto de datos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eb8fb062",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(datos.shape, etiquetas.shape)\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    datos, etiquetas, test_size=0.2, random_state=42\n",
    ")\n",
    "\n",
    "print(X_train.shape, X_test.shape, y_train.shape, y_test.shape)\n",
    "\n",
    "# Aplanar las imágenes para SVM\n",
    "X_train= X_train.reshape(X_train.shape[0], -1)\n",
    "X_test= X_test.reshape(X_test.shape[0], -1)\n",
    "\n",
    "# normalizar los píxeles a [0, 1]\n",
    "X_train= X_train/ 255.0\n",
    "X_test= X_test / 255.0\n",
    "\n",
    "print(\"Dimensiones después de aplanar:\")\n",
    "print(X_train.shape, X_test.shape, y_train.shape, y_test.shape)"
   ]
  }
